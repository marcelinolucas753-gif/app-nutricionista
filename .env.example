NODE_ENV=development
HOST=127.0.0.1
PORT=4173
DATABASE_URL=postgresql://nutri_app:nutri_app_local@127.0.0.1:5432/nutri_guia
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Opcional: modelo más rápido para tareas cortas (resumen, cambiar una comida, receta, sustituciones, compras).
# Si no se define, se usa OPENAI_MODEL.
# OPENAI_MODEL_FAST=
# Opcional: precio de tu modelo en USD por millón de tokens, para estimar el costo en Ajustes > Uso de la IA.
# OPENAI_PRICE_INPUT_PER_MILLION=
# OPENAI_PRICE_OUTPUT_PER_MILLION=
# Generá una clave privada distinta para cada instalación. Ejemplo: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=
# En producción (Render) usá una carpeta de un disco persistente, por ejemplo /var/data/backups
BACKUP_DIR=./backups
# Opcional: otra dirección compatible con la API de OpenAI
# OPENAI_BASE_URL=
# Detrás de un proxy (Render lo es) se usa automáticamente en producción. En otros servidores con proxy, poné 1.
# TRUST_PROXY=1
